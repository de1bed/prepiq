{
  "name": "prepiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PrepIQ: operación de cocina para restaurantes (KDS, meseros, inventario por receta, etiquetas, horarios y asistencia) sobre Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "dev/test-db.sh",
    "test:e2e": "dev/local-stack/up.sh && playwright test",
    "stack:up": "dev/local-stack/up.sh",
    "stack:down": "dev/local-stack/down.sh",
    "db:reset": "dev/db-reset.sh --seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/query-sync-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "pg": "^8.13.1",
    "postcss": "^8.4.47",
    "supabase": "^2.54.11",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
