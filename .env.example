# Copia este archivo a .env.local y llena los valores de TU proyecto Supabase
# (Supabase → Project Settings → API). La "anon/publishable key" es pública por
# diseño: la seguridad la dan las políticas RLS. NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
